# Supabase project → Settings → API. The service_role key bypasses RLS: never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated frontend origins allowed to call the API (the CRM)
CORS_ORIGINS=http://localhost:3000
