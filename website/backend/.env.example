# Supabase project → Settings → API. The service_role key bypasses RLS: never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The website's own address: allowed to call this API, and used in links inside lead notes.
CORS_ORIGINS=http://localhost:3001
WEBSITE_URL=http://localhost:3001
