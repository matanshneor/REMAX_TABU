# Supabase project → Settings → API. The service_role key bypasses RLS: never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Public website leads (POST /public/leads). CORS_ORIGINS above must include the website's address.
WEBSITE_URL=http://localhost:3001
CRM_URL=http://localhost:3000
# Lead emails go out from this Gmail box with a Google app password (myaccount.google.com/apppasswords).
# Without it, leads are still saved with a bell notification; only the email is skipped.
GMAIL_USER=remaxtabu@gmail.com
GMAIL_APP_PASSWORD=
